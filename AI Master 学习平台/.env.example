# ============================================================
# AI Master 星辰学习系统 · 模型配置文件示例
# ============================================================
# 用法二选一，推荐第一种：
#   ① 什么都不改 —— 启动后打开 http://127.0.0.1:5178/setup
#      在网页里填（有「测试连接」按钮，填错会告诉你错在哪）
#   ② 把本文件复制成 .env，改下面的值，然后重启平台
#
# 详细图文教程见压缩包根目录的《大模型添加说明书和教程.md》
# ============================================================

# ── 大模型配置（选填；不填也能用，只是没有 AI 功能）──────────
# 默认给的是 DeepSeek 官方接口。任何 OpenAI 兼容接口都可以，
# 填到 /v1 为止即可，不用带后面的 /chat/completions。
STARLAB_AI_BASE_URL=https://api.deepseek.com/v1
STARLAB_AI_MODEL=deepseek-chat
# 在这里粘贴你自己的 API Key（形如 sk-xxxxxxxx）。
# 申请地址：https://platform.deepseek.com/api_keys
ARK_API_KEY=

# 备用模型：主模型额度耗尽或不可用时按顺序尝试（留空表示不切换）
# 多个用英文逗号分隔，例如：deepseek-reasoner
STARLAB_AI_FALLBACK_MODELS=

# 推理过程：disabled 首字更快，学习问答默认关掉；
# 想看到模型的思考过程就改成 enabled（首字会慢 5–8 秒）。
STARLAB_AI_THINKING=disabled

# ── 其他服务商示例（把上面三行换成对应的一组即可）────────────
#   硅基流动   STARLAB_AI_BASE_URL=https://api.siliconflow.cn/v1
#              STARLAB_AI_MODEL=deepseek-ai/DeepSeek-V3
#   通义千问   STARLAB_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#              STARLAB_AI_MODEL=qwen-plus
#   火山方舟   STARLAB_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#              STARLAB_AI_MODEL=你的推理接入点 ID
#   本地 Ollama STARLAB_AI_BASE_URL=http://localhost:11434/v1
#              STARLAB_AI_MODEL=qwen2.5:7b
#              ARK_API_KEY=ollama
